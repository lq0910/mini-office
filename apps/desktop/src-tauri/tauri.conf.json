{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mini Office",
  "version": "0.1.8",
  "identifier": "com.minioffice.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mini Office",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "轻量、离线优先的跨平台办公套件",
    "longDescription": "Mini Office 支持 DOCX、XLSX、PPTX 的查看、编辑与安全保存，提供 Word 合同编辑、Excel 公式计算和 PPT 高保真演示。",
    "copyright": "© 2026 Mini Office",
    "fileAssociations": [
      {
        "ext": [
          "docx",
          "dotx"
        ],
        "name": "Mini Office 文档",
        "description": "Word 文档",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "rank": "Alternate",
        "contentTypes": [
          "org.openxmlformats.wordprocessingml.document",
          "org.openxmlformats.wordprocessingml.template"
        ]
      },
      {
        "ext": [
          "docm"
        ],
        "name": "Mini Office 含宏文档",
        "description": "Word 含宏文档",
        "role": "Editor",
        "mimeType": "application/vnd.ms-word.document.macroEnabled.12",
        "rank": "Alternate",
        "contentTypes": [
          "org.openxmlformats.wordprocessingml.document.macroenabled"
        ]
      },
      {
        "ext": [
          "xlsx",
          "xltx"
        ],
        "name": "Mini Office 工作簿",
        "description": "Excel 工作簿",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "rank": "Alternate",
        "contentTypes": [
          "org.openxmlformats.spreadsheetml.sheet",
          "org.openxmlformats.spreadsheetml.template"
        ]
      },
      {
        "ext": [
          "xlsm"
        ],
        "name": "Mini Office 含宏工作簿",
        "description": "Excel 含宏工作簿",
        "role": "Editor",
        "mimeType": "application/vnd.ms-excel.sheet.macroEnabled.12",
        "rank": "Alternate",
        "contentTypes": [
          "org.openxmlformats.spreadsheetml.sheet.macroenabled"
        ]
      },
      {
        "ext": [
          "pptx",
          "potx"
        ],
        "name": "Mini Office 演示文稿",
        "description": "PowerPoint 演示文稿",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "rank": "Alternate",
        "contentTypes": [
          "org.openxmlformats.presentationml.presentation",
          "org.openxmlformats.presentationml.template"
        ]
      },
      {
        "ext": [
          "pptm"
        ],
        "name": "Mini Office 含宏演示文稿",
        "description": "PowerPoint 含宏演示文稿",
        "role": "Editor",
        "mimeType": "application/vnd.ms-powerpoint.presentation.macroEnabled.12",
        "rank": "Alternate",
        "contentTypes": [
          "org.openxmlformats.presentationml.presentation.macroenabled"
        ]
      },
      {
        "ext": [
          "csv"
        ],
        "name": "Mini Office 表格文本",
        "description": "CSV 文本",
        "role": "Editor",
        "mimeType": "text/csv",
        "rank": "Alternate",
        "contentTypes": [
          "public.comma-separated-values-text"
        ]
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "Mini Office PDF 文档",
        "description": "PDF 文档",
        "role": "Viewer",
        "mimeType": "application/pdf",
        "rank": "Alternate",
        "contentTypes": [
          "com.adobe.pdf"
        ]
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Mini Office Markdown 文本",
        "description": "Markdown 文本",
        "role": "Viewer",
        "mimeType": "text/markdown",
        "rank": "Alternate",
        "contentTypes": [
          "net.daringfireball.markdown",
          "public.plain-text"
        ]
      },
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "Mini Office HTML 网页",
        "description": "HTML 网页",
        "role": "Viewer",
        "mimeType": "text/html",
        "rank": "Alternate",
        "contentTypes": [
          "public.html"
        ]
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
